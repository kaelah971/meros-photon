# Meros — P0 environment template (placeholders only, no secrets)
# Copy to .env.local and fill in. Never commit real values.

# --- Walrus Memory (Mainnet relayer, server-only) ---
# Ed25519 delegate private key (hex or suiprivkey1...). Server-only.
MEMWAL_PRIVATE_KEY=
# Walrus Memory account object ID on Sui (0x...). Server-only.
MEMWAL_ACCOUNT_ID=
# Relayer URL. Default is Mainnet relayer if unset.
# Mainnet: https://relayer.memory.walrus.xyz
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz

# --- Gemini (scaffold only in P0, server-only) ---
GEMINI_API_KEY=

# --- Neon Postgres (operational metadata only, NOT the memory store) ---
DATABASE_URL=

# --- Better Auth owner sessions (server-only) ---
# Public origin of THIS deployment. Local dev default: http://localhost:3002
# (Meros dev port; 3000/3001 belong to other projects). Production: set to
# the real Meros origin, e.g. https://meros.example.com. Origin validation
# stays enabled — requests must match this origin (plus trustedOrigins).
BETTER_AUTH_URL=
# Long-lived signing secret. REQUIRED in production (process fails fast
# without it). Generate once, e.g. `openssl rand -base64 32`, and keep it
# stable — rotating invalidates all sessions. Never commit real values.
BETTER_AUTH_SECRET=

# --- Meros identity derivation ---
# Optional salt mixed into the access-code hash. Changing it remaps all namespaces.
MEROS_ID_SALT=meros-p0-v1

# --- Legacy dev identity (local diagnostics ONLY) ---
# Enables raw access-code bootstrap on the legacy dev endpoints
# (/api/memory/*, /api/tenant/resolve) and the /chat + /dev consoles.
# Disabled by default: unset or "false" keeps product APIs session-only.
# Production NEVER permits legacy identity, even if this is "true".
# MEROS_ENABLE_LEGACY_DEV_IDENTITY=true

# --- Gemini models (server-only; IDs must come from a live models.list, never guessed) ---
# Primary default: gemini-3.5-flash-lite. Fallback default: gemini-3.7-flash.
GEMINI_MODEL=
# Fallback runs only on retryable/model-availability failures of the primary.
GEMINI_FALLBACK_MODEL=

# --- Photon / Spectrum Cloud iMessage (server-only) ---
# Cloud-mode credentials from https://app.photon.codes plus the per-webhook
# signing secret shown once when the endpoint is registered. All three are
# required for /api/photon/imessage to receive AND reply. Placeholders only.
IMESSAGE_PROJECT_ID=
IMESSAGE_PROJECT_SECRET=
IMESSAGE_WEBHOOK_SECRET=
